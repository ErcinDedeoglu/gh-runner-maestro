# GitHub Runner Maestro Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# Global default token for runners without explicit tokens
DEFAULT_RUNNER_TOKEN=ghp_your_github_personal_access_token_here

# Logging configuration
LOG_LEVEL=INFO

# Optional: Custom runner image
RUNNER_IMAGE=dublok/gh-runner:latest

# Usage with RUNNERS_MATRIX:
# In docker-compose.yml, use ${VARIABLE_NAME} for token substitution:
#
# - RUNNERS_MATRIX: |
#     [
#       {"url":"https://github.com/your-org/repo1","count":3,"labels":"dind,ubuntu-latest","token":"${DEFAULT_RUNNER_TOKEN}","image":"dublok/gh-runner:v1"},
#       {"url":"https://github.com/your-org/repo2","count":2,"labels":"self-hosted","token":"${REPO2_TOKEN}"}
#     ]
#
# Then define the variables in this .env file:
# REPO2_TOKEN=ghp_another_token_here